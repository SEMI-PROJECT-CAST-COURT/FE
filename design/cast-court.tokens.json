          "dark": "#121214",
          "light": "#f6f5f2",
          "dark-hc": "#000000",
          "light-hc": "#ffffff"
        }
      },
      "surface": {
        "$type": "color",
        "$description": "카드·패널",
        "var": "--surface",
        "$value": {
          "dark": "#1e1f23",
          "light": "#ffffff",
          "dark-hc": "#0b0b0c",
          "light-hc": "#ffffff"
