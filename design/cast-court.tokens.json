      "$type": "color",
      "$value": "#2f6fe0",
      "$description": "주요 버튼·선택 테두리(accent). 모든 테마 공통"
    },
    "on-primary": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "primary·danger-btn 위 글자"
    },
    "accent-alternatives": {
      "$type": "color",
      "$value": [
        "#2f6fe0",
        "#7c5ce0",
        "#c2410c"
      ],
      "$description": "시안 tweak 후보(기본 #2f6fe0). 구현 시 하나로 고정"
