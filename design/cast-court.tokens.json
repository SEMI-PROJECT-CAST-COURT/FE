{
  "$meta": {
    "name": "CAST COURT",
    "source": "CAST COURT 화면 시안 (Design canvas) — 20개 보드에서 추출",
    "themeSwitch": {
      "attribute": "html[data-theme=\"light\"|\"dark\"]",
      "contrast": "html[data-contrast=\"high\"]",
      "storage": {
        "cc-theme": "system | light | dark",
        "cc-contrast": "high | normal"
      },
      "default": "system (prefers-color-scheme)"
    },
    "modes": [
      "dark",
      "light",
      "dark-hc",
      "light-hc"
    ],
    "rule": "화면은 색을 직접 쓰지 않고 var(--토큰)만 사용. 예외: primary #2f6fe0, on-color #ffffff"
  },
  "color": {
    "바탕·면": {
      "bg": {
        "$type": "color",
        "$description": "페이지 바탕",
        "var": "--bg",
